{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node apps/api/src/seed.js && npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "apps/api/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
