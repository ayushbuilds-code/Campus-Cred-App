# Copy to apps/api/.env or export these before `npm start`.
PORT=4000
# REQUIRED in production: a long random string. The server refuses to start in production with the default.
JWT_SECRET=change-me-to-a-long-random-string
# Where the web app is reachable. Certificate QR codes point here.
PUBLIC_URL=http://localhost:4000
# Database / file locations (defaults are under apps/api/data)
# DB_PATH=./apps/api/data/campuscred.db
# UPLOAD_DIR=./apps/api/data/uploads
# CERT_DIR=./apps/api/data/certs
# Seconds before the check-in QR / code rotates (a screenshot lives 1x to 2x this long)
ROTATE_SECONDS=20
# Set to 0 to hide the demo-account list and the OTP shown in the response
DEMO_MODE=1
# Allowed browser origins if the web app is served from a different domain (comma separated)
# CORS_ORIGIN=https://clubs.example.edu
